{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "editor",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "cwd": "editor",
      "port": 5180
    },
    {
      "name": "neat-dist",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4178",
        "--directory",
        "editor/dist"
      ],
      "port": 4178
    }
  ]
}
